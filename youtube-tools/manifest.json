{
  "manifest_version": 3,
  "name": "Toolbox for Brain",
  "version": "0.2.0",
  "description": "Digital wellbeing toolkit — video resize, site blocking, and more.",
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.svg",
      "48": "icons/icon48.svg",
      "128": "icons/icon128.svg"
    }
  },
  "permissions": ["storage", "tabs", "activeTab", "contextMenus"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content/resize.js"],
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/block.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "zoom_in": {
      "suggested_key": { "default": "Ctrl+Shift+Up", "mac": "Command+Shift+Up" },
      "description": "Increase zoom"
    },
    "zoom_out": {
      "suggested_key": { "default": "Ctrl+Shift+Down", "mac": "Command+Shift+Down" },
      "description": "Decrease zoom"
    }
  }
}
